{
  "_comment": "PLACEHOLDER",
  "backend": "dealii",
  "physics": "hp_adaptive",
  "pitfall_index": 3,
  "mode": "cmd",
  "expect_in_output": [
    "run_under_test_kept_every_cell_at_the_lowest_degree=true",
    "run_under_test_is_at_least_ten_times_less_accurate=true",
    "run_under_test_used_a_smoothness_estimator=false",
    "hp_refinement_symbol=p_adaptivity_from_relative_threshold",
    "p_adaptivity_from_smoothness_occurrences_in_headers=0",
    "VERDICT=without_a_smoothness_estimator_the_run_is_h_only"
  ],
  "forbid_in_output": [
    "BUILD_FAILED",
    "UNKNOWN_PROBE",
    "VERDICT=p_adaptivity_raised_the_polynomial_degree"
  ],
  "timeout_seconds": 900
}
