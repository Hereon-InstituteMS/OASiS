    "serial_run_is_unaffected=True",
    "two_rank_run_with_scatter_reverse_matches_serial=True",
    "ranks=2 scatter=False child_RESULT=",
    "\"ranks\": 2, \"scatter\": false, \"converged\": false",
    "VERDICT=missing_scatter_reverse_breaks_only_the_parallel_run"
