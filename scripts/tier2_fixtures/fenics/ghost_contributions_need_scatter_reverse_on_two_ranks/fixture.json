  "forbid_in_output": [
    "Traceback",
    "mpirun_not_found=True",
    "child_produced_no_result",
    "VERDICT=children_did_not_run",
    "VERDICT=missing_scatter_reverse_was_harmless_on_two_ranks"
  ],
