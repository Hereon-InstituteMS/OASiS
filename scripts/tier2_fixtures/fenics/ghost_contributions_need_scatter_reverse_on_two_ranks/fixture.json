{
  "_comment": "PLACEHOLDER",
  "backend": "fenics",
  "physics": "matrix_free_poisson",
  "pitfall_index": 4,
  "mode": "python",
  "covers": ["matrix_free_poisson::4"],
  "expect_in_output": [
    "two_rank_run_missed_rtol_within_the_iteration_cap=True",
